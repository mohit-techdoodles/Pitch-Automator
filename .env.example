# ==========================================
# Pitch Automator Environment Configuration
# ==========================================

# Outbound Mail Server (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Inbound Mail Server (IMAP)
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"

# Sender Identity & Mailbox App Password
SENDER_EMAIL="outreach@yourdomain.com"
SENDER_NAME="Your Name"
MAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Quota & Safe Pacing Settings
DAILY_SEND_LIMIT="40"
MIN_DELAY_SEC="180"
MAX_DELAY_SEC="420"

# Local Storage
OUTREACH_DB="outreach.db"
LEADS_CSV="sample_leads.csv"
